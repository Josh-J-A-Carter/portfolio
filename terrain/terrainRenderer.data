#version 300 es

precision highp float;


in vec3 f_normal;
in vec2 f_uv;

out vec4 fragColor;


uniform sampler2D height_data;
uniform sampler2D amplitude_data;
uniform sampler2D moisture_data;

float height(vec2 uv) {
    return texture(height_data, uv).x * (1.0f - texture(amplitude_data, uv).x);
}

float smoothmap(float t) {
    return ((6.0f * t - 15.0f) * t + 10.0f) * t * t * t;
}

void main() {
    
    ////// Basic lighting model
    const vec3 dir = vec3(0.0f, -1.0f, -1.0f);

    const vec4 upperCol = vec4(1.2f, 1.2f, 1.2f, 1.0f);
    const vec4 dryCol = vec4(1.0f, 0.6f, 0.3f, 1.0f);
    const vec4 wetCol = vec4(0.3f, 0.6f, 0.3f, 1.0f);


    float light = dot(normalize(f_normal), normalize(dir));
    if (light < 0.0) light = 0.0f;
    light += 0.1f;

    ///// Cool idea but link to player's exact position, not uv distance lol
    // float uv_dist = length(f_uv - vec2(0.5f, 0.5f));
    // light += 1.0f * 2.0f * uv_dist * uv_dist;

    float altitude = height(f_uv);
    float moisture = texture(moisture_data, f_uv).x;

    vec4 col = mix(dryCol, wetCol, smoothmap(moisture));
    col = mix(col, upperCol, pow(sin(altitude * 1.57f), 2.0f));

    fragColor = vec4(col.xyz * light, 1.0f);


    ////// Debugging

    // normals
    // vec3 n = normalize(f_normal);
    // fragColor = vec4(n.x, n.y, n.z, 1.0f);

    // uv
    // vec2 val = texture(height_data, f_uv).xy;
    // fragColor = vec4(val.xy, 0.0f, 1.0f);

    // raw noise
    // float val = texture(height_data, f_uv).x;
    // fragColor = vec4(val, val, val, 1.0f);
}
#version 300 es

precision highp float;

layout (location = 0) in vec3 v_pos;
layout (location = 1) in vec2 v_uv;

out vec3 f_normal;
out vec2 f_uv;

uniform mat4 mat_modl;
uniform mat4 mat_view;
uniform mat4 mat_proj;

uniform sampler2D height_data;
uniform sampler2D amplitude_data;

uniform int chunk_radius;
uniform int chunk_x;
uniform int chunk_z;

float height(vec2 uv) {
    return texture(height_data, uv).x * (1.0f - texture(amplitude_data, uv).x);
}

void main() {
    // Map UV for this chunk segment, into the entire grid of chunks
    float num_chunks = float(2 * chunk_radius - 1);
    vec2 uv = v_uv / num_chunks;
    uv = uv + vec2(float(chunk_x) / num_chunks, float(chunk_z) / num_chunks);
    f_uv = uv;

    // World position
    vec4 world_pos = mat_modl * vec4(v_pos.x, v_pos.y, v_pos.z, 1.0f);
    float x = world_pos.x;
    float z = world_pos.z;

    float y = height(uv);
    // float y = 0.0f;

    const float max_height = 30.0f;
    world_pos = vec4(x, y * max_height, z, 1.0f);
    gl_Position = mat_proj * mat_view * world_pos;    


    // Normal vector
    int width = textureSize(height_data, 0).x;
    float delta = 2.0f / float(width);
 
    vec3 dx = vec3(2.0f * delta, height(uv + vec2(delta, 0.0f)) - height(uv - vec2(delta, 0.0f)), 0.0f);
    vec3 dz = vec3(0.0f, height(uv + vec2(0.0f, delta)) - height(uv - vec2(0.0f, delta)), 2.0f * delta);

    f_normal = cross(dx, dz);
}
